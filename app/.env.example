# ---------------------------------------------------------------------------
# NavoPulse configuration. Copy to .env (Docker) or apps/web/.env.local (dev).
# In development every secret below has an insecure built-in default, so the
# app runs with no .env at all. In production (NODE_ENV=production) the ones
# marked REQUIRED must be set or the server refuses to start.
# ---------------------------------------------------------------------------

# Database (REQUIRED in production)
DATABASE_URL=postgres://navopulse:navopulse@localhost:5432/navopulse
POSTGRES_PASSWORD=navopulse

# Public URL of this deployment (used in links sent to citizens)
APP_URL=http://localhost:3000

# Session signing secret (REQUIRED). Generate: openssl rand -base64 48
SESSION_SECRET=
# AES-256-GCM key for personal data at rest, 32 bytes base64 (REQUIRED). Generate: openssl rand -base64 32
# Losing or changing this key makes stored mobile numbers and names unreadable.
DATA_ENCRYPTION_KEY=

# --- NavoBot / Copilot Studio ------------------------------------------------
# Webhook auth for POST /api/integrations/navobot/tickets: set an API key
# (simplest for Power Automate) and/or an HMAC secret.
# NAVOBOT_API_KEY=
# NAVOBOT_WEBHOOK_SECRET=
# Embedded Web Chat: either the token endpoint from Copilot Studio
# (Settings > Channels > Mobile app) or a Direct Line secret. Leave both empty
# to use the built-in demo bot.
# COPILOT_TOKEN_ENDPOINT=
# DIRECTLINE_SECRET=

# --- SMS gateway ---------------------------------------------------------------
# console (logs only) | semaphore | twilio
SMS_PROVIDER=console
# SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=NAVOPULSE
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Shared secret your SMS provider sends to /api/integrations/sms/inbound (REQUIRED)
SMS_INBOUND_SECRET=
# The number citizens text for the offline SOS fallback (shown in the app)
NEXT_PUBLIC_SMS_GATEWAY_NUMBER=+639000000000

# --- Push notifications --------------------------------------------------------
# console | fcm
PUSH_PROVIDER=console
# Firebase service-account JSON on one line (Project settings > Service accounts)
# FCM_SERVICE_ACCOUNT_JSON=

# --- Maps ------------------------------------------------------------------------
# Defaults to OpenStreetMap tiles. For Mapbox:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/{z}/{x}/{y}?access_token=YOUR_TOKEN
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_ATTRIBUTION=

# --- Official hotlines (must be confirmed with the city before any public demo) ---
# NEXT_PUBLIC_HOTLINE_DRRMO=
# NEXT_PUBLIC_HOTLINE_PNP=
# NEXT_PUBLIC_HOTLINE_BFP=

# --- Storage ------------------------------------------------------------------
# Local folder for uploaded photos (swap StorageProvider for S3/R2/Azure in production)
# STORAGE_DIR=

# Set to 1 only behind a reverse proxy that overwrites X-Forwarded-For
TRUST_PROXY=0

# --- Demo switches --------------------------------------------------------------
# Show OTP codes on screen and demo logins on the dashboard login page.
# Never enable on a public deployment.
NAVOPULSE_DEMO_OTP=0
NEXT_PUBLIC_DEMO_MODE=1
